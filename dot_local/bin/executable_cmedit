#!/usr/bin/env python3
import os
import subprocess

managed = subprocess.run(
    ["chezmoi", "managed", "--path-style", "absolute"], capture_output=True, check=False
).stdout.decode()
files = [
    file
    for file in managed.splitlines()
    if not os.path.isdir(file)
]
fzf = subprocess.Popen(
    [
        "fzf",
        "-m",
        "--height",
        "90%",
        "--preview",
        "bat --theme Nord --style=numbers --color=always --line-range :500 '{}'",
        "--preview-window",
        "~4,+{2}+4/3,<80(down)",
    ],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
)
files_to_edit = fzf.communicate("\n".join(files).encode())[0].decode().splitlines()
if files_to_edit:
    _ = subprocess.run(
        ["chezmoi", "edit", "--apply", "--watch"]
        + files_to_edit,
        check=False,
    )
