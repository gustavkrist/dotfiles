#!/usr/bin/env bash
set -euo pipefail

PI_SESSION_DIR="$(pwd | gsed -s 's:\b/:-:g;s:/::;s:.*:--\0--:')"

# Run the rex server + run.sh by default; skip both with --no-rex or SBX_NO_REX.
# Anything before `--` belongs to pisbx; only args after `--` are forwarded.
USE_REX=1
ARGS=()
SEEN_SEP=0
for arg in "$@"; do
    if [ "$SEEN_SEP" = 1 ]; then
        ARGS+=("$arg")
        continue
    fi
    case "$arg" in
        --) SEEN_SEP=1 ;;
        --no-rex) USE_REX=0 ;;
        *)
            echo "pisbx: unexpected argument '$arg'; pass pi args after '--'" >&2
            exit 2
            ;;
    esac
done
if [ -n "${SBX_NO_REX:-}" ]; then
    USE_REX=0
fi

# The rex port is only published when the in-container rex server runs.
PORT_ARGS=()
if [ "$USE_REX" = 1 ]; then
    PORT_ARGS=(-p 7297:7297)
fi

docker run -d -it -e NEURALWATT_API_KEY -v "$PWD:/home/node/workspace" ${PORT_ARGS[@]+"${PORT_ARGS[@]}"} --name pi pi-agent:local 1>/dev/null
mkdir -p "$HOME/.pi/agent/sessions/$PI_SESSION_DIR/"
docker cp "$HOME/.pi/agent/sessions/$PI_SESSION_DIR/" pi:/home/node/.pi/agent/sessions/--home-node-workspace--/ 1>/dev/null
docker exec -u root pi chown -R node:node /home/node/.pi/agent/sessions/--home-node-workspace--/ 1>/dev/null
if [ "$USE_REX" = 1 ]; then
    docker exec pi rex server start --extra-listen :7297 --allow-anonymous 1>/dev/null
    docker exec pi /home/node/run.sh ${ARGS[@]+"${ARGS[@]}"}
else
    docker exec -it pi pi ${ARGS[@]+"${ARGS[@]}"}
fi
docker cp pi:/home/node/.pi/agent/sessions/--home-node-workspace--/ "$HOME/.pi/agent/sessions/$PI_SESSION_DIR/" 1>/dev/null
mv "$HOME/.pi/agent/sessions/$PI_SESSION_DIR/--home-node-workspace--"/* "$HOME/.pi/agent/sessions/$PI_SESSION_DIR" && rm -r "$HOME/.pi/agent/sessions/$PI_SESSION_DIR/--home-node-workspace--" 1>/dev/null
docker kill pi 1>/dev/null
docker rm pi 1>/dev/null
