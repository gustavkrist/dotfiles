;; vim:ft=scheme
(defcfg
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 120
  movemouse-smooth-diagonals yes
)

(defvirtualkeys
  fasttypingstate XX
)

#|
(deflayer name
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)
|#

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft up
  fn   lctl lalt lmet           spc            rmet ralt      left down rght
)

(defvar
  tot 220  ;; tot=time out tap
)

(deftemplate type (action)
  (multi
    (fork
      (hold-for-duration 55 fasttypingstate)
      XX
      (lctl rctl lalt ralt lmet rmet)
    )
    $action
  )
)

(deftemplate homerowmod (timeouttap timeouthold keytap keyhold)
  (switch
    ((input virtual fasttypingstate)) (t! type $keytap) break
    () (tap-hold $timeouttap $timeouthold
         (t! type $keytap)
         $keyhold
       ) break
  )
)

(defalias
  .fn (layer-while-held function)
  hyp (multi lctl lalt lmet lsft)
  cln (switch
    ((base-layer base)) (layer-switch clean) break
    ((base-layer clean)) (layer-switch base) break
  )
  off (switch
    ((base-layer base)) (layer-switch disabled) break
    ((base-layer disabled)) (layer-switch base) break
  )

  mml (movemouse-left 4 4)
  mmr (movemouse-right 4 4)
  mmd (movemouse-down 4 4)
  mmu (movemouse-up 4 4)
  msl (movemouse-left 2 2)
  msr (movemouse-right 2 2)
  msd (movemouse-down 2 2)
  msu (movemouse-up 2 2)
  scl (mwheel-left 50 120)
  scr (mwheel-right 50 120)
  scd (mwheel-down 50 120)
  scu (mwheel-up 50 120)
  fst (movemouse-speed 200)
  slw (movemouse-speed 50)
  vsl (movemouse-speed 25)

  sft (
    tap-hold
    $tot
    160
    (fork
      (one-shot 1000 rsft)
      (caps-word-custom-toggle
        2000
        (a b c d e f g h i j k l m n o p q r s t u v w x y z)
        (lsft rsft - bspc del)
      )
      (rsft)
    )
    rsft)
)

(defchordsv2
  (e r) = 30 all-released (clean disabled mouse)
  (c v) S-= 50 all-released (clean disabled mouse)
  (u i) - 30 all-released (clean disabled mouse)
  (m ,) S-- 50 all-released (clean disabled mouse)
  (r t) lbrc 50 all-released (clean disabled mouse)
  (y u) rbrc 50 all-released (clean disabled mouse)
  (f g) S-9 50 all-released (clean disabled mouse)
  (h j) S-0 50 all-released (clean disabled mouse)
  (v b) S-lbrc 50 all-released (clean disabled mouse)
  (n m) S-rbrc 50 all-released (clean disabled mouse)
  (i o) bksl 30 all-released (clean disabled mouse)
  (, .) S-bksl 50 all-released (clean disabled mouse)
  (w e) ; 30 all-released (clean disabled mouse)
  (x c) S-; 50 all-released (clean disabled mouse)
  (q w) grv 50 all-released (clean disabled mouse)
  (z x) S-1 50 all-released (clean disabled mouse)
  (o p) S-6 50 all-released (clean disabled mouse)
  (. /) S-4 50 all-released (clean disabled mouse)
)

(deflayermap (base)
  ;; define home row mods
  f (t! homerowmod $tot 160 f lsft)
  j (t! homerowmod $tot 160 j rsft)
  d (t! homerowmod $tot 160 d lctl)
  k (t! homerowmod $tot 160 k rctl)
  s (t! homerowmod $tot 180 s lalt)
  l (t! homerowmod $tot 160 l lalt)
  a (t! homerowmod $tot 160 a lmet)
  ; (t! homerowmod $tot 160 ' rmet)
  n (t! homerowmod $tot 160 n @hyp)
  caps (tap-hold $tot 160 esc lctl)
  lmet (tap-hold $tot 160 M-tab (layer-while-held nav))
  rmet (layer-while-held nums)
  lalt (layer-while-held mouse)
  ralt (layer-while-held syms)
  rsft @sft
  ;; define each letter
  q (t! type q) w (t! type w) e (t! type e) r (t! type r) t (t! type t)
  y (t! type y) u (t! type u) i (t! type i) o (t! type o) p (t! type p)
  ;; a (t! type a) s (t! type s) d (t! type d) f (t! type f)
  g (t! type g) h (t! type h)
  ;;  j (t! type j) k (t! typek) l (t! type l)
  z (t! type z) x (t! type x) c (t! type c) v (t! type v) b (t! type b)
  ;; n (t! type n)
  m (t! type m)
  fn @.fn
)

(deflayer function
  @cln brdn brup lpad mctl bldn blup prev pp   next mute vold volu
  _    _    _    _    _    _    _    _    _    _    _    _    _    @off
  _    _    _    _    lrld _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer nums
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lbrc 7    8    9    rbrc _    _    _    _    _    _    _    _
  _    scln 4    5    6    eql  _    rsft rctl lalt rmet _    _
  _    _    grv  1    2    3    bksl @hyp _    _    _    _    _    _
  _    _    _    _              0              _    _    _    _    _
)

(deflayer syms
  _    _      _     _    _    _      _      _    _    _    _    _    _
  _    _      _     _    _    _      _      _    _    _    _    _    _    _
  _    S-lbrc S-7   S-8  S-9  S-rbrc _      _    _    _    _    _    _    _
  _    S-scln S-4   S-5  S-6  S-eql  _      rsft rctl lalt rmet _    _
  _    _      S-grv S-1  S-2  S-3    S-bksl @hyp _    _    _    _    _    _
  _    _      _     _                S-0              _    _    _    _    _
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    M-y  M-v  M-c  M-x  M-z  _    _    _
  _    lmet lalt lctl lsft _    lft  down up   rght _    _    _
  _    _    _    _    _    _    _    _    home pgup pgdn end  _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer mouse
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    @mml @mmd @mmu @mmr _    _    _
  _    lmet lalt lctl lsft _    _    @msl @msd @msu @msr _    _
  _    _    _    @fst @slw @vsl _    _    @scl @scd @scu @scr _    _
  _    _    _    _              _              _    _    _    _    _
)

(deflayer disabled
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  @.fn XX   XX   XX             XX             XX   XX   XX   XX   XX
)

(deflayer clean
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft up
  @.fn lctl lalt lmet           spc            rmet ralt      left down rght
)
